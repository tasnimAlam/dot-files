#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob globstar

prefix="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
entries=("$prefix"/**/*.gpg)
entries=("${entries[@]#"$prefix"/}")
entries=("${entries[@]%.gpg}")

choice=$(printf '%s\n' "${entries[@]}" | bemenu -i -p 'pass:') || exit 0
[[ -n $choice ]] || exit 0

case "${1:-copy}" in
  type) pass show "$choice" | head -n1 | tr -d '\n' | wtype - ;;
  otp)  pass otp  "$choice" | tr -d '\n' | wl-copy -o ;;
  *)    pass show "$choice" | head -n1 | tr -d '\n' | wl-copy -o ;;
esac
