#!/usr/bin/fish --no-config
# switch — pick any window from all monitors with bemenu, then focus it.
# Hyprland >= 0.52: hyprctl dispatch takes Lua, so listing and focusing both go through repl.

set -l rows (hyprctl repl '
local out = {}
for _, w in ipairs(hl.get_windows()) do
  if w.mapped then
    local class = (tostring(w.class):gsub("%-[%d.]+$", ""))
    out[#out+1] = table.concat({
      tostring(w.address),
      class:match("[^.]+$") or class,
      (tostring(w.title):gsub("%s+", " ")),
    }, "\t")
  end
end
return table.concat(out, "\n")
')

test (count $rows) -gt 0; or exit 0

set -l names
for r in $rows
    set -a names (string split \t -- $r)[2]
end

# Bare app name, except where two windows share one — then the title tells them apart.
set -l labels
for i in (seq (count $rows))
    if test (count (string match -- $names[$i] $names)) -gt 1
        set -a labels (printf '%s — %s' $names[$i] (string split \t -- $rows[$i])[3])
    else
        set -a labels $names[$i]
    end
end

# Hint key per window: first letter of the app name not already taken, then any free letter.
set -l hints
for n in $names
    set -l h ''
    for c in (string split '' -- (string lower -- $n)) (string split '' abcdefghijklmnopqrstuvwxyz)
        if string match -qr '^[a-z]$' -- $c; and not contains -- $c $hints
            set h $c
            break
        end
    end
    set -a hints $h
end

# Uppercase the rest so a lowercase key can only match its hint; --auto-select then picks it at once.
# shortcut: windows past 26 get no hint (arrow keys only), upgrade to two-letter hints if that happens.
for i in (seq (count $labels))
    set labels[$i] (printf '%s  %s' $hints[$i] (string upper -- $labels[$i]))
end

set -l choice (printf '%s\n' $labels | bemenu --auto-select -l 9 -p window)
test -n "$choice"; or exit 0

set -l i (contains -i -- $choice $labels); or exit 1
set -l addr (string split \t -- $rows[$i])[1]

hyprctl repl "
local w = hl.get_window([==[address:$addr]==])
if w then
  hl.dispatch(hl.dsp.focus({ window = w }))
  return 'focused'
end
return 'gone'
"
