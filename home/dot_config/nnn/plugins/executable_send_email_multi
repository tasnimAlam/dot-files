#!/bin/bash
# Description: Send selected files as email attachment to multiple recipients
# Dependencies: mailutils
# Shell: Bash
# Author: Tasnim Alam

selection=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}

# Prompt the user for the recipient's email addresses
read -p "Enter email addresses (separated by spaces): " -a emails

# Create zip file from selected files
cat "$selection" | tr '\0' '\n' | xargs -n1 basename | tar -cvzf attach.zip -T - | sleep 1

# Send zip file as email attachment to each email address
for email in "${emails[@]}"; do
    echo "Sending mail to $email" | mail -s "File attached" -a "attach.zip" "$email"
done

# Remove zip file
rm attach.zip

